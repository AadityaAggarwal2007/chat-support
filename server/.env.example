# PostgreSQL connection string (use your existing Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/chat_support"

# Server port
PORT=3001

# Dashboard JWT secret (generate a random string)
JWT_SECRET="change-this-to-a-random-secret-string"

# Dashboard login password
DASHBOARD_PASSWORD="your-secure-password"

# AI Provider — OpenRouter (supports DeepSeek, Qwen, etc.)
CODEX_URL="https://openrouter.ai/api"

# OpenRouter API key (get from https://openrouter.ai/keys)
AI_API_KEY="sk-or-v1-your-key-here"

# Default AI model (can be switched from dashboard settings)
# Options:
#   deepseek/deepseek-chat         — DeepSeek V3      ($0.27/$1.10 per M tokens, caching supported)
#   deepseek/deepseek-chat-v3-0324 — DeepSeek V3 0324 ($0.27/$1.10 per M tokens, caching supported)
#   qwen/qwen-2.5-72b-instruct    — Qwen 2.5 72B     ($0.36/$0.36 per M tokens)
#   qwen/qwq-32b                  — Qwen QwQ 32B      ($0.20/$0.20 per M tokens, cheapest)
AI_MODEL="deepseek/deepseek-chat"

# Your VPS public URL (used for widget embed code generation)
SERVER_PUBLIC_URL="https://yourdomain.com"

# Base URL for customer order-tracking links.
# Used only when a business has no tracking_domain set in the Tracker DB.
TRACKING_BASE_URL="https://shiptrack.store"

# Dashboard URL (for CORS)
DASHBOARD_URL="https://yourdomain.com:3000"
